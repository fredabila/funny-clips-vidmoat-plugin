# Port to listen on (most hosts set this for you)
PORT=3000
# Public URL of this server, used for the sound-effect and text-card URLs the tools return.
# If unset it is derived from the Host / X-Forwarded-* headers.
PUBLIC_BASE_URL=https://funny-clips.example.com
# Optional clip sources. Without them only your own library is searched.
GIPHY_API_KEY=
PEXELS_API_KEY=
# Optional: require this header on /mcp. Set the same name/value in Vidmoat's plugin form.
PLUGIN_SECRET=
PLUGIN_SECRET_HEADER=x-funny-clips-secret
# Optional: path to your clip catalog (default ./library.json)
LIBRARY_PATH=library.json
